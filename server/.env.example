# Server
PORT=4200
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Database (Neon / Supabase Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dreammaker?sslmode=require"

# Auth (Clerk — verifies sessions/JWTs issued by the client app)
